{
  "name": "nape-studio",
  "main": "worker.js",
  "compatibility_date": "2026-11-25",
  "workers_dev": false,
  "routes": [{ "pattern": "nape-pro.jerrymk.com", "custom_domain": true }],
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "directory": "./public",
    "not_found_handling": "404-page",
  },
}
